diff -ruN a/policy/src/shed_home_write.rs b/policy/src/shed_home_write.rs
--- a/policy/src/shed_home_write.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/policy/src/shed_home_write.rs	2026-11-06 17:09:11.813969685 +0000
@@ -0,0 +1,60 @@
+//! MUTANT for the task's accuracy check (tests/mutants), not a policy to keep: a "load shedder"
+//! at the home-timeline service that answers one WriteHomeTimeline in five with an empty OK
+//! before the handler runs, instead of failing it (so the error rate stays 0). The compose
+//! succeeds, but the post never reaches its followers' home timelines.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use rpcstack::{Extensions, MissingDependency, Module, ModuleServer, ServerInit, WireIn};
+use tonic::{CowGrpcMethod, Response, Status};
+
+/// The empty answer (every prost message is Default).
+trait Empty: Sized {
+    fn empty() -> Option<Self>;
+}
+impl<T> Empty for T {
+    default fn empty() -> Option<Self> {
+        None
+    }
+}
+impl<T: Default> Empty for T {
+    fn empty() -> Option<Self> {
+        Some(T::default())
+    }
+}
+
+static WRITES: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Debug)]
+pub struct ShedHomeWriteServer;
+
+impl ModuleServer for ShedHomeWriteServer {
+    fn new(_init: &mut ServerInit) -> Result<Self, MissingDependency> {
+        Ok(Self)
+    }
+}
+
+#[derive(Debug)]
+pub struct ShedHomeWrite {
+    shed: bool,
+}
+
+impl Module for ShedHomeWrite {
+    type Server = ShedHomeWriteServer;
+    const NAME: &'static str = "shed_home_write";
+    type Wire = ();
+
+    fn new(method: &CowGrpcMethod, _server: &ShedHomeWriteServer, _wire: &WireIn<'_>, _ext: &mut Extensions) -> Self {
+        let shed = method.method() == "WriteHomeTimeline" && WRITES.fetch_add(1, Ordering::Relaxed) % 5 == 4;
+        Self { shed }
+    }
+
+    fn before_poll<Ret>(&self, _ext: &mut Extensions) -> Result<(), Result<Response<Ret>, Status>> {
+        if self.shed {
+            if let Some(empty) = <Ret as Empty>::empty() {
+                return Err(Ok(Response::new(empty)));
+            }
+        }
+        Ok(())
+    }
+}
